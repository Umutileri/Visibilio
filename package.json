    "@types/node": "^24.5.2",
    "@types/react": "^19.1.13",
    "@types/react-dom": "^19.1.9",
    "eslint": "9.39.5",
    "eslint-plugin-react-hooks": "7.0.0",
    "eslint-plugin-react-refresh": "0.4.16",
    "playwright": "1.55.0",
    "prettier": "3.6.2",
    "tsx": "4.19.2",
    "typescript": "~5.9.2",
